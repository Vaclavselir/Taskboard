@page "/tasks/edit/{Id:guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using TaskBoard.Domain
@using TaskBoard.UI.Models.Tasks
@using TaskBoard.UI.Components.Shared

@inject TasksClient TasksClient
@inject NavigationManager Navigation

<AuthorizeView>

    <Authorized>

        <PageTitle>Upravit task</PageTitle>

        <div class="row justify-content-center mt-4">
            <div class="col-md-8 col-lg-6">

                @if (_isLoading)
                {
                    <div class="d-flex justify-content-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Načítání...</span>
                        </div>
                    </div>
                }
                else if (_notFound)
                {
                    <div class="alert alert-warning" role="alert">
                        Task nebyl nalezen. Možná byl smazán.
                        <a href="/tasks" class="alert-link">Zpět na seznam</a>
                    </div>
                }
                else
                {

                    <h3 class="mb-4">Upravit task</h3>

                    @if (_errorMessage is not null)
                    {
                        <div class="alert alert-danger alert-dismissible" role="alert">
                            @_errorMessage
                            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
                        </div>
                    }

                    @if (_conflictMessage is not null)
                    {
                        <div class="alert alert-warning" role="alert">
                            @_conflictMessage
                            <button class="btn btn-sm btn-outline-warning ms-2" @onclick="ReloadTask">
                                Načíst aktuální verzi
                            </button>
                        </div>
                    }

                    <TaskForm Model="_model"
                              OnValidSubmit="HandleUpdate"
                              ShowStatus="true"
                              SubmitLabel="Uložit změny"
                              IsSubmitting="_isSubmitting"
                              CancelHref="/tasks" />

                }

            </div>
        </div>

    </Authorized>

    <NotAuthorized>
        @{ Navigation.NavigateTo("/login"); }
    </NotAuthorized>

</AuthorizeView>

@code {

    [Parameter]
    public Guid Id { get; set; }

    private TaskFormModel _model = new TaskFormModel();

    private string? _eTag;

    private bool _isLoading = true;

    private bool _notFound;

    private bool _isSubmitting;

    private string? _errorMessage;

    private string? _conflictMessage;

    protected override async Task OnInitializedAsync()
    {

        await LoadTask();

    }

    private async Task LoadTask()
    {

        _isLoading = true;
        _notFound = false;
        _errorMessage = null;
        _conflictMessage = null;

        try
        {

            TaskDetailResult? result = await TasksClient.GetByIdAsync(Id);

            if (result?.Task is null)
            {

                _notFound = true;

                return;

            }

            _eTag = result.ETag;

            TaskDto? task = result.Task;

            _model = new TaskFormModel
            {
                Title = task.Title,
                Description = task.Description,
                Priority = Enum.TryParse<Priority>(task.Priority, ignoreCase: true, out Priority p) ? p : Priority.Low,
                Status = Enum.TryParse<Status>(task.Status, ignoreCase: true, out Status s) ? s : Status.Todo,
                DueDate = task.DueDate,
                Tags = task.Tags?.ToList() ?? []
            };

        }
        catch (Exception ex)
        {

            _errorMessage = $"Nepodařilo se načíst task: {ex.Message}";

        }
        finally
        {

            _isLoading = false;

        }

    }

    private async Task HandleUpdate()
    {

        _isSubmitting = true;
        _errorMessage = null;
        _conflictMessage = null;

        try
        {

            UpdateTaskModel? request = new UpdateTaskModel
            {
                Title = _model.Title,
                Description = _model.Description,
                Priority = _model.Priority,
                Status = _model.Status,
                DueDate = _model.DueDate
            };

            PatchTaskResult? result = await TasksClient.PatchAsync(Id, request, _eTag);

            if (result.Success)
            {

                Navigation.NavigateTo(uri: "/tasks");

                return;

            }

            if (result.Conflict)
            {

                _conflictMessage = "Někdo jiný mezitím tento task změnil.";

                return;

            }

            _errorMessage = result.ErrorMessage ?? "Nepodařilo se uložit změny.";

        }
        catch (Exception ex)
        {

            _errorMessage = $"Chyba: {ex.Message}";

        }
        finally
        {

            _isSubmitting = false;

        }

    }

    private async Task ReloadTask()
    {

        await LoadTask();

    }

}
