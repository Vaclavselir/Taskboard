@using TaskBoard.Domain
@using TaskBoard.UI.Models.Tasks

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit" class="needs-validation">

    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label fw-semibold">Název tasku</label>
        <InputText @bind-Value="Model.Title"
                   class="form-control"
                   placeholder="Co je potřeba udělat?" />
        <ValidationMessage For="() => Model.Title" class="text-danger small mt-1" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Popis</label>
        <InputTextArea @bind-Value="Model.Description"
                       class="form-control"
                       rows="3"
                       placeholder="Podrobnější popis (nepovinné)" />
    </div>

    <div class="row mb-3">
        <div class="@(ShowStatus ? "col-md-6" : "col-12")">
            <label class="form-label fw-semibold">Priorita</label>
            <InputSelect @bind-Value="Model.Priority" class="form-select">
                @foreach (var p in Enum.GetValues<Priority>())
                {
                    <option value="@p">@p</option>
                }
            </InputSelect>
            <ValidationMessage For="() => Model.Priority" class="text-danger small mt-1" />
        </div>

        @if (ShowStatus)
        {
            <div class="col-md-6">
                <label class="form-label fw-semibold">Status</label>
                <InputSelect @bind-Value="Model.Status" class="form-select">
                    @foreach (var s in Enum.GetValues<Status>())
                    {
                        <option value="@s">@s</option>
                    }
                </InputSelect>
            </div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Deadline</label>
        <InputDate @bind-Value="Model.DueDate" class="form-control" />
    </div>

    <div class="mb-4">
        <label class="form-label fw-semibold">Tagy</label>
        <div class="input-group">
            <input type="text"
                   class="form-control"
                   placeholder="Zadej tag a přidej..."
                   @bind="_newTag"
                   @bind:event="oninput"
                   @onkeydown="HandleTagKeyDown"
                   @onkeydown:preventDefault="_preventEnter" />
            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="AddTag"
                    disabled="@string.IsNullOrWhiteSpace(_newTag)">
                Přidat
            </button>
        </div>

        @if (Model.Tags.Count > 0)
        {
            <div class="d-flex flex-wrap gap-2 mt-2">
                @foreach (var tag in Model.Tags)
                {
                    <span class="badge bg-secondary d-flex align-items-center gap-1 px-2 py-1">
                        @tag
                        <button type="button"
                                class="btn-close btn-close-white ms-1"
                                style="font-size: 0.6rem;"
                                @onclick="() => RemoveTag(tag)"
                                aria-label="Odebrat tag">
                        </button>
                    </span>
                }
            </div>
        }
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">
            @if (IsSubmitting)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            @SubmitLabel
        </button>

        @if (CancelHref is not null)
        {
            <a href="@CancelHref" class="btn btn-outline-secondary">Zrušit</a>
        }
    </div>

</EditForm>

@code {

    [Parameter, EditorRequired]
    public TaskFormModel Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback OnValidSubmit { get; set; }

    /// <summary>
    /// When true, the Status dropdown is visible (Edit mode).
    /// </summary>
    [Parameter]
    public bool ShowStatus { get; set; } = false;

    [Parameter]
    public string SubmitLabel { get; set; } = "Uložit";

    [Parameter]
    public bool IsSubmitting { get; set; } = false;

    /// <summary>
    /// Optional href for the Cancel button. When null, no cancel button is shown.
    /// </summary>
    [Parameter]
    public string? CancelHref { get; set; }

    private string _newTag = string.Empty;

    private void AddTag()
    {

        var trimmed = _newTag.Trim();

        if (string.IsNullOrWhiteSpace(trimmed))
            return;

        if (!Model.Tags.Contains(trimmed, StringComparer.OrdinalIgnoreCase))
            Model.Tags.Add(trimmed);

        _newTag = string.Empty;

    }

    private void RemoveTag(string tag)
    {

        Model.Tags.Remove(tag);

    }

    private bool _preventEnter;

    private void HandleTagKeyDown(KeyboardEventArgs e)
    {

        _preventEnter = e.Key == "Enter";
        
        if (e.Key == "Enter")
        {

            AddTag();

        }

    }

    private async Task HandleValidSubmit()
    {

        await OnValidSubmit.InvokeAsync();

    }

}
