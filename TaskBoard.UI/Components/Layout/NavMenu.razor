@using Microsoft.AspNetCore.Components.Authorization
@using TaskBoard.UI.Services.Auth;

@inject AuthStateService AuthStateService
@inject NavigationManager Navigation


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">TaskBoard</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <AuthorizeView>

            <Authorized>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="tasks" Match="NavLinkMatch.All">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Moje tasky
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="tasks/create">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Nový task
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <span class="nav-link text-light small">
                        @context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                    </span>
                </div>

                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link text-warning small" @onclick="Logout">
                        Odhlásit se
                    </button>
                </div>


            </Authorized>

            <NotAuthorized>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Přihlášení
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="register">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Registrace
                    </NavLink>
                </div>
                
            </NotAuthorized>

            

        </AuthorizeView>

    </nav>
</div>


@code {
    private void Logout()
    {
        AuthStateService.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login");
    }
}
